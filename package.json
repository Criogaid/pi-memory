{
  "name": "@criogaid/pi-memory",
  "version": "0.3.0",
  "description": "Claude Code-style auto memory for pi: file-based memories with a MEMORY.md index, pinned memories, recall injection, restricted automatic extraction, dream consolidation, /memory and /pause-memory commands.",
  "type": "module",
  "homepage": "https://github.com/Criogaid/pi-memory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Criogaid/pi-memory.git"
  },
  "bugs": {
    "url": "https://github.com/Criogaid/pi-memory/issues"
  },
  "keywords": ["pi-package", "pi", "memory"],
  "files": ["src", "README.md", "PORT-MATRIX.md", "IMPLEMENTATION.md"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "node --import jiti/register --test test/regressions.test.ts && node --import jiti/register test/e2e-acceptance.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "22.19.19",
    "@types/proper-lockfile": "4.1.4",
    "jiti": "2.7.0",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.2 <0.86",
    "@earendil-works/pi-coding-agent": ">=0.84.2 <0.86",
    "@earendil-works/pi-tui": ">=0.84.2 <0.86",
    "typebox": "*"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  }
}
